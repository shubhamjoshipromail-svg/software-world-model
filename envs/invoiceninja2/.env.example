# Copied to .env by `swm up invoiceninja2`. __NAME__ placeholders are replaced with random local-only values.
# IN application vars
APP_URL=http://localhost:8014
APP_KEY=__APP_KEY__
APP_ENV=production
APP_DEBUG=false
REQUIRE_HTTPS=false
PHANTOMJS_PDF_GENERATION=false
PDF_GENERATOR=snappdf
TRUSTED_PROXIES='*'


CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=debian_docker

# DB connection
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ninja
DB_USERNAME=ninja
DB_PASSWORD=__DB_PASSWORD__
DB_ROOT_PASSWORD=__DB_ROOT_PASSWORD__
DB_CONNECTION=mysql

# Create initial user
# Default to these values if empty
IN_USER_EMAIL=agent@swm.test
IN_PASSWORD=__ADMIN_PASSWORD__
# IN_USER_EMAIL=
# IN_PASSWORD=

# Mail options
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS='user@example.com'
MAIL_FROM_NAME='Self Hosted User'

# MySQL
MYSQL_ROOT_PASSWORD=__DB_ROOT_PASSWORD__
MYSQL_USER=ninja
MYSQL_PASSWORD=__DB_PASSWORD__
MYSQL_DATABASE=ninja

# GoCardless/Nordigen API key for banking integration
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=

IS_DOCKER=true
SCOUT_DRIVER=null
#SNAPPDF_CHROMIUM_PATH=/usr/bin/google-chrome-stable


